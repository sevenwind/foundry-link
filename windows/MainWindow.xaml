<Window x:Class="FoundryLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Foundry Link" Width="680" Height="560" MinWidth="560">
  <DockPanel Margin="12">
    <TextBlock x:Name="StatusText" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" Foreground="White" Background="#D9C0392B" Padding="6" Visibility="Collapsed" Margin="0,0,0,6" TextWrapping="Wrap"/>
    <DockPanel DockPanel.Dock="Top" Margin="0,6">
      <Button x:Name="JoinBtn" DockPanel.Dock="Right" Content="Войти в сеть" Padding="12,4" Margin="8,0,0,0" Click="Join_Click"/>
      <TextBox x:Name="NwidBox" FontFamily="Consolas" Padding="4"/>
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" Foreground="Gray" Text="Введите 16-значный ID сети. После входа хост должен подтвердить ваш ID." Margin="0,0,0,8"/>
    <TextBlock DockPanel.Dock="Top" Text="Соединения с участниками" FontWeight="SemiBold" Margin="0,8,0,4"/>
    <ListView x:Name="PeerList" DockPanel.Dock="Bottom" Height="170">
      <ListView.View><GridView>
        <GridViewColumn Header="Узел" Width="130" DisplayMemberBinding="{Binding Address}"/>
        <GridViewColumn Header="Тип связи" Width="200" DisplayMemberBinding="{Binding Kind}"/>
        <GridViewColumn Header="Пинг" Width="90" DisplayMemberBinding="{Binding Ping}"/>
      </GridView></ListView.View>
    </ListView>
    <ListBox x:Name="NetList">
      <ListBox.ItemTemplate><DataTemplate>
        <DockPanel Margin="2">
          <Button DockPanel.Dock="Right" Content="Выйти" Padding="8,2" Tag="{Binding Id}" Click="Leave_Click"/>
          <StackPanel>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Line}" FontFamily="Consolas" Foreground="Gray" FontSize="11"/>
          </StackPanel>
        </DockPanel>
      </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
